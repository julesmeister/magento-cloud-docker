<script type="text/javascript">
require(['jquery'], function($) {
    'use strict';
    
    $(document).ready(function() {
        const apiUrl = '<?= $block->escapeUrl($config['apiUrl']) ?>';
        const chatWidget = $('#ai-search-chat-widget');
        const chatToggle = $('#chat-toggle');
        const chatWindow = $('#chat-window');
        const chatClose = $('#chat-close');
        const chatInput = $('#chat-input');
        const chatSend = $('#chat-send');
        const chatMessages = $('#chat-messages');
        const loadingIndicator = $('#loading-indicator');
        
        // Show the widget
        chatWidget.show();
        
        // Toggle chat window
        chatToggle.on('click', function() {
            chatWindow.toggle();
            if (chatWindow.is(':visible')) {
                chatInput.focus();
            }
        });
        
        // Close chat window
        chatClose.on('click', function() {
            chatWindow.hide();
        });
        
        // Send message on Enter key
        chatInput.on('keypress', function(e) {
            if (e.which === 13) {
                sendMessage();
            }
        });
        
        // Send message on button click
        chatSend.on('click', sendMessage);
        
        function sendMessage() {
            const message = chatInput.val().trim();
            if (!message) return;
            
            // Add user message to chat
            addMessage(message, 'user');
            chatInput.val('');
            
            // Show loading indicator
            showLoading();
            
            // Send to AI API
            $.ajax({
                url: apiUrl + '/search',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    query: message,
                    limit: 5
                }),
                timeout: 30000
            })
            .done(function(response) {
                hideLoading();
                
                if (response.ai_response) {
                    addMessage(response.ai_response, 'bot');
                    
                    // Add product results if available
                    if (response.products && response.products.length > 0) {
                        addProductResults(response.products);
                    }
                } else {
                    addMessage('Sorry, I encountered an error. Please try again.', 'bot');
                }
            })
            .fail(function(xhr, status, error) {
                hideLoading();
                console.error('AI Search API error:', error);
                
                if (status === 'timeout') {
                    addMessage('The search is taking longer than expected. Please try again.', 'bot');
                } else {
                    addMessage('Sorry, I\'m having trouble connecting to the search service. Please try again later.', 'bot');
                }
            });
        }
        
        function addMessage(content, sender) {
            const messageDiv = $('<div>', {
                class: 'message ' + sender + '-message'
            });
            
            const contentDiv = $('<div>', {
                class: 'message-content',
                text: content
            });
            
            messageDiv.append(contentDiv);
            chatMessages.append(messageDiv);
            
            // Scroll to bottom
            chatMessages.scrollTop(chatMessages[0].scrollHeight);
        }
        
        function addProductResults(products) {
            const resultsDiv = $('<div>', { class: 'product-results' });
            
            products.slice(0, 3).forEach(function(product) {
                const productDiv = $('<div>', { class: 'product-result' });
                
                productDiv.html(`
                    <div class="product-info">
                        <h4>${product.name}</h4>
                        <p class="product-price">$${product.price}</p>
                        <p class="product-category">${product.category}</p>
                    </div>
                `);
                
                if (product.url) {
                    productDiv.on('click', function() {
                        window.open(product.url, '_blank');
                    });
                    productDiv.addClass('clickable');
                }
                
                resultsDiv.append(productDiv);
            });
            
            chatMessages.append(resultsDiv);
            chatMessages.scrollTop(chatMessages[0].scrollHeight);
        }
        
        function showLoading() {
            loadingIndicator.show();
            chatSend.prop('disabled', true);
        }
        
        function hideLoading() {
            loadingIndicator.hide();
            chatSend.prop('disabled', false);
        }
    });
});
</script>

